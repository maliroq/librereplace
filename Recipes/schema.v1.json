{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LibreReplace Studio recipe (declarative v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "sourceWorkflow", "requirements", "componentIDs", "actions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
    "sourceWorkflow": {"type": "string", "minLength": 1, "maxLength": 200},
    "requirements": {"type": "array", "minItems": 1, "maxItems": 64,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "essential"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"},
          "essential": {"type": "boolean"}
        }
      }
    },
    "componentIDs": {"type": "array", "minItems": 1, "maxItems": 32,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"}
    },
    "actions": {"type": "array", "maxItems": 128,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["kind", "targetID"],
        "properties": {
          "kind": {"enum": ["installHomebrewCask", "installHomebrewFormula", "invokeBuiltInBridge", "verifyCapability"]},
          "targetID": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,79}$"}
        }
      }
    }
  }
}
